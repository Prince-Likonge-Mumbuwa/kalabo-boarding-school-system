# Hostinger (Apache / LiteSpeed) settings for the school app.
# Copied into dist/spa by the build — upload it together with the other files.

# --- Host page cache (LiteSpeed on Hostinger) ---------------------------
# Pages and version.json must always come from the files just published,
# never from the host's page cache — otherwise an update only appears after
# people clear their cache. Build files (hashed names), pictures and face
# models may be cached. Must come before the rules below.
<IfModule LiteSpeed>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/(assets|images|models)/
  RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# --- Single-page app: every page address loads index.html ---------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files and folders are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # A missing build file must stay a 404 (not index.html), so the app can
  # notice an update and reload.
  RewriteRule ^assets/ - [L,R=404]
  # A missing picture must also be a 404, never the app page (the PDF
  # logo would silently disappear).
  RewriteRule ^images/ - [L,R=404]
  # Face recognition models: a missing model must be a 404, never the app
  # page, or face recognition fails with a confusing error.
  RewriteRule ^models/ - [L,R=404]
  # NOCACHE: the app page must never be kept by a browser, proxy or the
  # host's cache, whatever address it was opened at.
  RewriteRule ^ index.html [L,E=NOCACHE:1]
</IfModule>

# --- File types ----------------------------------------------------------
# Face recognition runs on WebAssembly; browsers refuse it without this type.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .onnx
</IfModule>

# --- Caching -------------------------------------------------------------
<IfModule mod_headers.c>
  # Pictures such as the school logo: cache for a week, so a new logo
  # shows up within days.
  <FilesMatch "\.(png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Build files have a content hash in their name (index.AbC123xY.js):
  # cache for a year.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(js|css|woff2?|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Face recognition models change rarely: cache for a week.
  <FilesMatch "\.onnx$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The camera may be used by this site only (face recognition).
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
  # The page, the service worker and the version file must always be
  # checked for updates (open tabs read version.json to notice a new build).
  <FilesMatch "^(index\.html|sw\.js|manifest\.json|version\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set Cache-Control "no-cache, must-revalidate" env=NOCACHE
  Header set Cache-Control "no-cache, must-revalidate" env=REDIRECT_NOCACHE
</IfModule>

# --- Compression (smaller downloads) ------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/wasm application/octet-stream
</IfModule>
