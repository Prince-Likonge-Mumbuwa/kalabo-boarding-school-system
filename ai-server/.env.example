# Copy this file to ".env" (same folder: ai-server) and fill it in.
# Only the AI server reads this file. Nothing here is sent to the browser.

# --- SuperAdmin (used ONCE by "npm run create-superadmin") ---
# After the account is created you can delete the password from this file:
# only a scrambled (hashed) copy is kept in storage/superadmin.json.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- The school app ---
# The Firebase project teachers sign in to. The AI server uses it only to
# check that a teacher's sign-in token is genuine. It never reads Firestore.
FIREBASE_PROJECT_ID=catalyst-f1b1a
# Web addresses allowed to call this server (comma-separated).
CLIENT_ORIGIN=http://localhost:8080

# --- NVIDIA Build (https://build.nvidia.com/settings/api-keys, starts with nvapi-) ---
# One key is used for both writing (Nemotron) and searching (embeddings).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Several models may be listed, separated by commas: when NVIDIA retires the first
# (end of life), the server switches to the next one by itself and logs it.
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-super-120b-a12b
# Speed: Super (120B) is the fast, accurate choice. Ultra (550B) is much slower: avoid it for teachers.
# A smaller model for the light jobs (lesson evaluations, records of work, work plans).
# If your key cannot use it, the main model is used instead automatically.
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# If you change the embedding model, re-index every curriculum document
# (SuperAdmin console -> Curriculum library -> Re-index all).
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Room for the model's thinking plus the document. Raise it if long schemes of work stop early.
NVIDIA_MAX_TOKENS=16000
# Looks at pictures uploaded to the diagram library and suggests their title and labels.
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
GENERATION_TEMPERATURE=0.3
# Mathematics and Physics tests: a second AI call re-solves every question and sets the
# marking key out as worked steps with complete construction / graph figures. "off" saves that call.
# KEY_CHECK=off

# --- Speed and many teachers at once ---
# Documents written at the same time; other teachers wait in a queue and see their place.
# NVIDIA's free tier allows only a few at once; a paid host (DeepInfra) can take 8-16.
WRITER_CONCURRENCY=4
# How much each job "thinks" first (off | low | full) and its length limit in tokens.
# Defaults: assessment=low, keyCheck=full, everything else off. Uncomment to change:
# AI_EFFORT=assessment=low,keyCheck=full,lessonPlan=off,schemeOfWork=off
# AI_MAX_TOKENS=assessment=14000,keyCheck=14000,lessonPlan=6000,schemeOfWork=9000

# --- DeepInfra (https://deepinfra.com/dash/api_keys): paid host for the same Nemotron models ---
# Cheaper per document than most hosts and keeps no prompts. Leave the key
# empty to keep using NVIDIA only. Check it first: npm run check-deepinfra
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL,nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
DEEPINFRA_EMBEDDING_MODEL=nvidia/Nemotron-3.5-Embed-1B-BF16

# --- Which hosts to use, in order (a host without a key is skipped) ---
# Writing: if the first host fails before writing anything, the next one writes.
WRITER_HOSTS=deepinfra,nvidia
# Search: keep "nvidia" until check-deepinfra says DeepInfra matches your
# index; then "deepinfra,nvidia". (Indexing always uses the first host.)
SEARCH_HOSTS=nvidia

# --- ChromaDB (started by "npm run dev"; port 8100 so it does not clash with Company Knowledge AI) ---
CHROMA_URL=http://localhost:8100

# --- RAG settings (safe to experiment with) ---
# Map data of the school app, used to check maps in assessments (default: ../public/geo).
# GEO_DIR=../public/geo

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Local settings ---
PORT=5050
DATA_DIR=./storage
MAX_FILE_SIZE_MB=25
SESSION_HOURS=8
