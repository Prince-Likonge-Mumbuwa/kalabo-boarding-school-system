rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPERS ====================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isAdmin(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        getUserData(userId).userType == 'admin';
    }

    function isTeacher(userId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        getUserData(userId).userType == 'teacher';
    }

    // Collections with their own explicit rules. They are EXCLUDED from the
    // catch-all, because Firestore ORs matching rules — otherwise the
    // catch-all would silently override the restrictions below.
    function hasExplicitRules(collection) {
      return collection in [
        'users', 'teachers', 'classes', 'learners', 'results',
        'teacher_assignments', 'class_slots', 'assignment_events', 'system',
        'attendance_sessions',
        'reportCards', 'report_cards', 'attendanceTrends', 'examConfigs',
        'messages', 'campaigns', 'sms_logs',
        // Timetable feature
        'periods', 'school_holidays', 'timetable_entries',
        'timetable_submissions',
        // Timetable generator
        'timetable_config', 'timetable_versions', 'timetable_signoffs',
        // Year transition
        'enrollments', 'promotion_runs', 'promotion_run_items',
        // Admissions
        'staff_roles', 'admission_settings', 'admissions',
        // Face recognition (written only by Cloud Functions)
        'face_templates', 'face_status', 'face_audit',
        // Audit trail
        'audit_log'
      ];
    }

    // Collections the catch-all must NOT open to every signed-in account
    // (Firestore ORs matching rules); their own rules decide. face_templates
    // holds biometric data.
    function isPrivateCollection(collection) {
      return collection in ['face_templates', 'face_status', 'face_audit', 'audit_log'];
    }

    // ==================== HEADS OF DEPARTMENT ====================
    //
    // staff_roles/{uid}__hod  { department, status }   — given by an admin.
    // system/departments      { names, subjects: { [department]: [normalizedSubject] } }
    //
    // A HoD may:
    //   - add teachers to / remove them from THEIR department (users.departments),
    //   - allocate teachers of their department to their department's subjects,
    //     through the same assignment engine documents the admin uses
    //     (class_slots, teacher_assignments, assignment_events and the
    //     membership caches classes.teachers / users.assignedClasses).
    // A HoD may not touch Form Teacher slots or start covers / TP.

    function hodRolePath(uid) {
      return /databases/$(database)/documents/staff_roles/$(uid + '__hod');
    }

    function isHod() {
      return isTeacher(request.auth.uid)
        && exists(hodRolePath(request.auth.uid))
        && get(hodRolePath(request.auth.uid)).data.get('status', '') == 'active';
    }

    // Only call after isHod().
    function hodDept() {
      return get(hodRolePath(request.auth.uid)).data.get('department', '');
    }

    function hodSubjects() {
      return get(/databases/$(database)/documents/system/departments).data
        .get('subjects', {}).get(hodDept(), []);
    }

    // system/departments write by a HoD: only subjects[their department]
    // (a list), plus who/when.
    function hodSubjectsOnly() {
      let before = resource == null ? {} : resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['subjects', 'updatedBy', 'updatedByName', 'updatedAt'])
        && after.get('updatedBy', '') == request.auth.uid
        && after.get('subjects', {}) is map
        && after.get('subjects', {}).diff(before.get('subjects', {})).affectedKeys().hasOnly([hodDept()])
        && after.get('subjects', {}).get(hodDept(), []) is list
        && after.get('subjects', {}).get(hodDept(), []).size() <= 40;
    }

    function inHodDept(teacherId) {
      let u = get(/databases/$(database)/documents/users/$(teacherId)).data;
      // Older records only have the single `department` text; once the list
      // exists it is the only one that counts (as in the app).
      return u.get('departments', []).hasAny([hodDept()])
        || (u.get('departments', null) == null && u.get('department', '') == hodDept());
    }

    // A slot write by a HoD. `before` is null when the slot is new.
    function hodMaySlot(slotId, before, after) {
      return isHod()
        && slotId == after.get('classId', '') + '__' + after.get('normalizedSubject', '')
        && after.get('isFormTeacherSlot', false) == false
        && after.get('normalizedSubject', '') in hodSubjects()
        && (after.get('ownerTeacherId', null) == null || inHodDept(after.ownerTeacherId))
        && (
          after.get('delegateTeacherId', null) == null
          || (before != null
              && after.get('delegateTeacherId', null) == before.get('delegateTeacherId', null)
              && after.get('delegateStart', null) == before.get('delegateStart', null)
              && after.get('delegateEnd', null) == before.get('delegateEnd', null))
        );
    }

    // ==================== ASSIGNMENT ENGINE: AUTHORITY ====================

    function engineDoc() {
      return /databases/$(database)/documents/system/assignmentEngine;
    }

    // Switch: set system/assignmentEngine.enforceAuthority = true
    // once grade/attendance code writes normalizedSubject + enteredBy.
    function authorityEnforced() {
      return exists(engineDoc())
        && get(engineDoc()).data.get('enforceAuthority', false) == true;
    }

    // Slot doc id = {classId}__{normalizedSubject}
    function slotPath(classId, subj) {
      return /databases/$(database)/documents/class_slots/$(classId + '__' + subj);
    }

    // Cover / TP is live only between its dates (server time),
    // so handback to the Primary Owner is instant.
    function delegateLive(s) {
      return s.get('delegateTeacherId', null) != null
        && s.get('delegateStart', null) != null
        && s.get('delegateEnd', null) != null
        && request.time >= s.delegateStart
        && request.time <= s.delegateEnd;
    }

    function operatorOf(s) {
      return delegateLive(s) ? s.delegateTeacherId : s.get('ownerTeacherId', null);
    }

    function isOperator(classId, subj) {
      return isAuthenticated()
        && exists(slotPath(classId, subj))
        && operatorOf(get(slotPath(classId, subj)).data) == request.auth.uid;
    }

    // May this user enter / edit MARKS for this class + subject?
    // The Primary Owner always may (even while covered); a cover / TP
    // teacher may while their cover is live.
    function canEnterMarks(classId, subj) {
      return isAuthenticated()
        && exists(slotPath(classId, subj))
        && (
          get(slotPath(classId, subj)).data.get('ownerTeacherId', null) == request.auth.uid
          || operatorOf(get(slotPath(classId, subj)).data) == request.auth.uid
        );
    }

    // Owner or live cover/TP of a slot, by slot document id.
    function slotDoc(slotId) {
      return /databases/$(database)/documents/class_slots/$(slotId);
    }
    function isOwnerOrOperatorOfSlot(slotId) {
      return isAuthenticated()
        && slotId is string
        && exists(slotDoc(slotId))
        && (
          get(slotDoc(slotId)).data.get('ownerTeacherId', null) == request.auth.uid
          || operatorOf(get(slotDoc(slotId)).data) == request.auth.uid
        );
    }

    // Teacher may write results for this class/subject?
    function teacherMayCreate(d) {
      return isTeacher(request.auth.uid) && (
        !authorityEnforced() || (
          canEnterMarks(d.classId, d.normalizedSubject)
          && d.enteredBy == request.auth.uid
        )
      );
    }

    function teacherMayUpdate(before, after) {
      return isTeacher(request.auth.uid) && (
        !authorityEnforced() || (
          canEnterMarks(before.classId, before.normalizedSubject)
          && after.classId == before.classId
          && after.normalizedSubject == before.normalizedSubject
          && after.get('enteredBy', null) == before.get('enteredBy', null)
          && after.lastEditedBy == request.auth.uid
        )
      );
    }

    // Teacher may delete a result row?
    //   Authority enforced  → the slot's owner or live cover/TP.
    //   Not yet enforced    → only rows this teacher saved (teacherId or
    //                         enteredBy), so one teacher can't wipe another's.
    function teacherMayDelete(d) {
      return isTeacher(request.auth.uid) && (
        (authorityEnforced()
          && canEnterMarks(d.classId, d.get('normalizedSubject', '')))
        || (!authorityEnforced()
          && (d.get('teacherId', '') == request.auth.uid
              || d.get('enteredBy', '') == request.auth.uid))
      );
    }

    // ==================== RESULT SHAPE VALIDATION ====================
    // Applied to teacher writes only (admins can repair data freely).
    // Only fields every version of the app has always written are required,
    // so a teacher on an older cached build is not locked out.
    //   marks: >= 0 real mark, -1 absent, -2 not conducted
    function isValidResultShape(d) {
      return d.keys().hasAll([
        'studentId', 'classId', 'subjectId', 'examType',
        'term', 'year', 'marks', 'totalMarks'
      ])
      && d.studentId is string && d.studentId.size() > 0
      && d.classId is string && d.classId.size() > 0
      && d.subjectId is string && d.subjectId.size() > 0
      && d.examType in ['week4', 'week8', 'endOfTerm']
      && d.term in ['Term 1', 'Term 2', 'Term 3']
      && d.year is int
      && d.marks is number
      && d.totalMarks is number && d.totalMarks > 0
      && (d.marks == -1 || d.marks == -2 || (d.marks >= 0 && d.marks <= d.totalMarks));
    }

    // ==================== TEACHER ASSIGNMENT SHAPE VALIDATION ====================

    function isValidRoleType(v) {
      return v == 'substantive' || v == 'tp' || v == 'leave-cover';
    }

    function isValidStatus(v) {
      return v == 'active' || v == 'suspended' || v == 'ended';
    }

    function isValidEndReason(v) {
      return v == null || v in [
        'replaced', 'expired', 'handover', 'removed', 'cancelled',
        'transferred', 'returned-to-duty', 'tp-completed',
        'owner-replaced', 'promoted-to-owner'
      ];
    }

    function isValidAssignmentShape(d) {
      return d.keys().hasAll([
        'teacherId', 'classId', 'subject', 'normalizedSubject',
        'isFormTeacher', 'roleType', 'status'
      ])
      && d.teacherId is string
      && d.classId is string
      && d.subject is string
      && d.normalizedSubject is string
      && d.isFormTeacher is bool
      && isValidRoleType(d.roleType)
      && isValidStatus(d.status)
      && (!d.keys().hasAny(['endReason']) || isValidEndReason(d.endReason));
    }

    function isValidAssignmentUpdate() {
      let d = request.resource.data;
      return
        (!d.keys().hasAny(['roleType'])         || isValidRoleType(d.roleType))
        && (!d.keys().hasAny(['status'])        || isValidStatus(d.status))
        && (!d.keys().hasAny(['endReason'])     || isValidEndReason(d.endReason))
        && (!d.keys().hasAny(['teacherId'])     || d.teacherId is string)
        && (!d.keys().hasAny(['classId'])       || d.classId is string)
        && (!d.keys().hasAny(['subject'])       || d.subject is string)
        && (!d.keys().hasAny(['isFormTeacher']) || d.isFormTeacher is bool);
    }

    // ==================== USERS ====================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow list: if isAuthenticated();

      allow create: if isAdmin(request.auth.uid) || (
        isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.get('userType', '') != 'admin'
      );

      allow update: if isAdmin(request.auth.uid) || (
        isAuthenticated()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userType', 'status',
          'assignedClasses', 'assignedClassId', 'assignedClassName',
          'isFormTeacher', 'formClassId', 'formClassName',
          // departments are set by the HoD or an admin, never by the teacher
          'departments', 'department'
        ])
      ) || (
        // A HoD adds a teacher to / removes them from their own department only.
        isHod()
        && resource.data.get('userType', '') == 'teacher'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['departments', 'department', 'updatedAt'])
        && request.resource.data.get('departments', []) is list
        && request.resource.data.get('departments', []).toSet()
             .difference(resource.data.get('departments', []).toSet())
             .hasOnly([hodDept(), resource.data.get('department', '')])
        && resource.data.get('departments', []).toSet()
             .difference(request.resource.data.get('departments', []).toSet())
             .hasOnly([hodDept()])
      ) || (
        // After a HoD allocation the engine rebuilds the teacher's class list.
        // Form-class pointers may be written back, but never changed
        // (missing → null is the same value).
        isHod()
        && resource.data.get('userType', '') == 'teacher'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'assignedClasses', 'updatedAt',
             'formClassId', 'formClassName', 'isFormTeacher', 'assignedClassId', 'assignedClassName'])
        && request.resource.data.get('formClassId', null) == resource.data.get('formClassId', null)
        && request.resource.data.get('formClassName', null) == resource.data.get('formClassName', null)
        && request.resource.data.get('assignedClassId', null) == resource.data.get('assignedClassId', null)
        && request.resource.data.get('assignedClassName', null) == resource.data.get('assignedClassName', null)
        && request.resource.data.get('isFormTeacher', false) == resource.data.get('isFormTeacher', false)
      );

      allow delete: if isAdmin(request.auth.uid);
    }

    // ==================== TEACHERS ====================
    match /teachers/{teacherId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin(request.auth.uid) ||
        request.auth.uid == teacherId
      );
    }

    // ==================== CLASSES ====================
    match /classes/{classId} {
      allow read: if true;

      allow create: if isAdmin(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);

      allow update: if isAdmin(request.auth.uid) || (
        isTeacher(request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'teachers', 'formTeacherId', 'formTeacherName'
        ])
      ) || (
        // After a HoD allocation the engine rebuilds the class's teacher list
        // (the Form Teacher pointer may be written back, never changed).
        isHod()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachers', 'updatedAt', 'formTeacherId', 'formTeacherName'])
        && request.resource.data.get('formTeacherId', null) == resource.data.get('formTeacherId', null)
        && request.resource.data.get('formTeacherName', null) == resource.data.get('formTeacherName', null)
      );
    }

    // ==================== LEARNERS ====================
    match /learners/{learnerId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        isAdmin(request.auth.uid) || isTeacher(request.auth.uid)
      );
    }

    // ==================== FACE RECOGNITION ====================
    //
    // All face data is keyed by the learner's document id (learners/{id}),
    // which never changes when a learner is promoted, transferred or given a
    // new student number. Only the Cloud Functions (Admin SDK) write here.
    //
    //   face_templates/{learnerId}  encrypted face templates — NO app access
    //   face_status/{learnerId}     consent + number of faces + readable
    //                               snapshot (name, student number, class);
    //                               staff can read it to show badges
    //   face_audit/{id}             who enrolled / removed / scanned; admins
    // ==================== AUDIT TRAIL ====================
    //
    // audit_log/{id}: who did what, to which record, when — written by the
    // app after each change (client/lib/auditedFirestore.ts). Append-only:
    // nobody can change or delete an entry; only admins can read them. An
    // entry is always in the writer's own name, stamped with server time.
    match /audit_log/{entryId} {
      allow read: if isAdmin(request.auth.uid);
      allow create: if (isAdmin(request.auth.uid) || isTeacher(request.auth.uid))
        && request.resource.data.keys().hasOnly(['actorId', 'actorName', 'actorRole', 'at', 'clientAt', 'page', 'ops', 'areas', 'count'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.ops is list
        && request.resource.data.ops.size() > 0
        && request.resource.data.ops.size() <= 60;
      allow update, delete: if false;
    }

    match /face_templates/{learnerId} {
      allow read, write: if false;
    }
    match /face_status/{learnerId} {
      allow read: if isAdmin(request.auth.uid) || isTeacher(request.auth.uid);
      allow write: if false;
    }
    match /face_audit/{entryId} {
      allow read: if isAdmin(request.auth.uid);
      allow write: if false;
    }

    // ==================== RESULTS ====================
    match /results/{resultId} {
      allow read: if true;

      allow create: if isAdmin(request.auth.uid)
        || (teacherMayCreate(request.resource.data)
            && isValidResultShape(request.resource.data));

      allow update: if isAdmin(request.auth.uid)
        || (teacherMayUpdate(resource.data, request.resource.data)
            && isValidResultShape(request.resource.data));

      // Previously admin-only, which made the teacher "Delete results"
      // button on Results Entry fail with permission-denied.
      allow delete: if isAdmin(request.auth.uid)
        || teacherMayDelete(resource.data);
    }

    // ==================== ASSIGNMENT ENGINE ====================

    match /class_slots/{slotId} {
      // Public read: the Parent Portal (no sign-in) needs a class's subject
      // list so a parent's report card lists the same subjects as the
      // admin's. Slots hold class/subject/teacher names and cover dates —
      // the same teacher names already shown on public result rows.
      allow read: if true;
      allow create: if isAdmin(request.auth.uid)
        || hodMaySlot(slotId, null, request.resource.data);
      allow update: if isAdmin(request.auth.uid)
        || (hodMaySlot(slotId, resource.data, request.resource.data)
            && resource.data.get('normalizedSubject', '') == request.resource.data.get('normalizedSubject', ''));
      allow delete: if isAdmin(request.auth.uid);
    }

    match /teacher_assignments/{assignmentId} {
      allow read: if isAuthenticated();

      allow create: if isValidAssignmentShape(request.resource.data) && (
        isAdmin(request.auth.uid)
        || (
          // HoD: a substantive allocation of a department teacher to a department subject
          isHod()
          && request.resource.data.normalizedSubject in hodSubjects()
          && request.resource.data.isFormTeacher == false
          && request.resource.data.roleType == 'substantive'
          && request.resource.data.status == 'active'
          && request.resource.data.get('assignedBy', null) == request.auth.uid
          && inHodDept(request.resource.data.teacherId)
        )
      );

      allow update: if isValidAssignmentUpdate() && (
        isAdmin(request.auth.uid)
        || (
          // HoD: ending a tenure on one of their department's subjects
          isHod()
          && resource.data.get('normalizedSubject', '') in hodSubjects()
          && resource.data.get('isFormTeacher', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'endReason', 'endDate', 'updatedAt'])
          && request.resource.data.status == 'ended'
        )
      );

      allow delete: if false;
    }

    match /assignment_events/{eventId} {
      allow read: if isAdmin(request.auth.uid);
      allow create: if isAdmin(request.auth.uid)
        || (isHod() && request.resource.data.get('actorId', null) == request.auth.uid);
      allow update, delete: if false;
    }

    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(request.auth.uid);
      // A HoD chooses their own department's subjects; nothing else changes.
      allow create, update: if docId == 'departments' && isHod() && hodSubjectsOnly();
    }

    // ==================== YEAR TRANSITION ====================
    //
    // enrollments/{learnerId}_{year}: the class each learner was in during a
    // CLOSED academic year (written by the admin's year transition). Public
    // read: the Parent Portal (signed out) shows a past term's report card
    // from the class the child was in that year. Holds names, class and the
    // school's student id only — the same data already public on learners.
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if isAdmin(request.auth.uid);
    }

    // promotion_runs/{fromYear}-{toYear}: the stored plan, progress and undo
    // information of a year transition. Admin only.
    match /promotion_runs/{runId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(request.auth.uid);
    }

    // The run's learner lines, in chunks of 250 (one document would be too
    // large for a big school).
    match /promotion_run_items/{chunkId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(request.auth.uid);
    }

    // ==================== ADMISSIONS ====================
    //
    // staff_roles/{teacherId}__admissions-officer: school-wide roles given by
    // the admin. An ACTIVE admissions officer may enrol learners.
    function isAdmissionsOfficer() {
      return isTeacher(request.auth.uid)
        && exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid + '__admissions-officer'))
        && get(/databases/$(database)/documents/staff_roles/$(request.auth.uid + '__admissions-officer')).data.status == 'active';
    }

    match /staff_roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(request.auth.uid);
    }

    // admission_settings/{year}: the intake (open/closed, levels, places).
    // Officers may only move the admission counter on by one, which is what
    // makes two simultaneous admissions take turns.
    match /admission_settings/{year} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin(request.auth.uid);
      allow update: if isAdmin(request.auth.uid)
        || (
          isAdmissionsOfficer()
          && resource.data.isOpen == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seq', 'lastAdmissionAt'])
          && request.resource.data.seq == resource.data.seq + 1
        );
    }

    // admissions/{year}-{seq}: one record per admission (the printed slip).
    // Officers create their own; only the admin may change or cancel one.
    match /admissions/{admissionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(request.auth.uid)
        || (
          isAdmissionsOfficer()
          && request.resource.data.admittedBy == request.auth.uid
          && request.resource.data.status == 'admitted'
        );
      allow update, delete: if isAdmin(request.auth.uid);
    }

    // ==================== ATTENDANCE SESSIONS ====================
    //
    // One doc per (class, date, kind, [period, subject]). This is the ONLY
    // attendance collection the app writes. Rollups and indexes are derived
    // client-side from this collection.
    //
    // Session doc shape:
    //   { classId, className, date, kind, subject?, period?,
    //     normalizedSubject?, slotId?,
    //     markedBy, markedByName, markedAt, roster, excuseReasons?,
    //     summary, schemaVersion }
    //   period  = lesson number 1..8 (breaks are not periods; lessons end
    //             by 13:00)
    //   slotId  = class_slots id of the subject (periodic) or the form
    //             class '{classId}__form-teacher' (daily). Older registers
    //             have none.
    //
    // Visibility: any authenticated user (teachers + admins).
    // Create:     a teacher, as themselves. Once authority is enforced, only
    //             for a subject / form class they own or currently cover.
    // Update:     the original marker, the subject's owner or live cover, or
    //             an admin. Changing class/date/kind/period/subject is not
    //             allowed (would move the doc to a different session).
    // Delete:     the marker or the subject's owner / live cover (within
    //             7 days), or an admin.

    function isValidSessionShape(d) {
      return d.keys().hasAll([
        'classId', 'className', 'date', 'kind',
        'markedBy', 'markedByName', 'markedAt', 'roster',
        'summary', 'schemaVersion'
      ])
      && d.classId is string
      && d.className is string
      && d.date is string
      && (d.kind == 'daily' || d.kind == 'periodic')
      && d.markedBy is string
      && d.markedByName is string
      && d.roster is map
      && d.summary is map
      && d.schemaVersion == 1
      && (
        d.kind == 'daily'
        // period = lesson number P1..P8 (breaks are not numbered)
        || (d.period is int && d.period >= 1 && d.period <= 8
            && d.subject is string && d.subject.size() > 0)
      );
    }

    // The register's subject (periodic) or form class (daily), when the app
    // recorded it. Older registers have no slotId.
    function sessionSlotOk(d) {
      return d.get('slotId', null) != null && isOwnerOrOperatorOfSlot(d.slotId);
    }

    function sessionIdentityUnchanged(before, after) {
      return after.classId == before.classId
        && after.date == before.date
        && after.kind == before.kind
        && after.get('period', null) == before.get('period', null)
        && after.get('subject', null) == before.get('subject', null);
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();

      // A teacher creates registers as themselves. Once authority is
      // enforced, only for a subject / form class they own or cover.
      allow create: if isAdmin(request.auth.uid)
        || (
          isTeacher(request.auth.uid)
          && isValidSessionShape(request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
          && (!authorityEnforced() || sessionSlotOk(request.resource.data))
        );

      // Edit: the original marker, or the owner / live cover of the
      // register's subject (so owner and cover don't lock each other out).
      // The register's identity (class/date/kind/period/subject) is fixed,
      // and the editor records themselves as the marker.
      allow update: if (
        isAdmin(request.auth.uid)
        || (
          isTeacher(request.auth.uid)
          && (resource.data.markedBy == request.auth.uid || sessionSlotOk(resource.data))
          && sessionIdentityUnchanged(resource.data, request.resource.data)
          && request.resource.data.markedBy == request.auth.uid
        )
      ) && isValidSessionShape(request.resource.data);

      // The marker or the subject's owner / live cover (within 7 days),
      // or an admin.
      allow delete: if isAdmin(request.auth.uid)
        || (
          isTeacher(request.auth.uid)
          && (resource.data.markedBy == request.auth.uid || sessionSlotOk(resource.data))
          && request.time < resource.data.markedAt + duration.value(7, 'd')
        );
    }

    // ==================== TIMETABLE — PERIODS ====================
    //
    // School-wide bell schedule. Teachers need to read it (MyTimetable
    // grid, attendance picker) but only admins may write.
    //
    // Lessons are numbered 1..8 (order); break / lunch / assembly rows are
    // not periods and carry order 0. The school day ends at 13:00.
    //
    // Doc shape:
    //   { order: int (lesson 1..8, otherwise 0), name: string, startTime: 'HH:mm',
    //     endTime: 'HH:mm', kind: 'lesson'|'break'|'assembly'|'lunch',
    //     academicYear: int, isActive: bool, createdAt, updatedAt }

    function isValidPeriodShape(d) {
      return d.keys().hasAll(['order', 'name', 'startTime', 'endTime', 'kind', 'academicYear', 'isActive'])
        && d.order is int && d.order >= 0 && d.order <= 20
        && d.name is string && d.name.size() > 0
        && d.startTime is string
        && d.endTime is string
        && d.kind in ['lesson', 'break', 'assembly', 'lunch']
        && d.academicYear is int
        && d.isActive is bool;
    }

    match /periods/{periodId} {
      allow read: if isAuthenticated();

      allow create: if isAdmin(request.auth.uid)
        && isValidPeriodShape(request.resource.data);

      allow update: if isAdmin(request.auth.uid)
        && isValidPeriodShape(request.resource.data);

      allow delete: if isAdmin(request.auth.uid);
    }

    // ==================== TIMETABLE — SCHOOL HOLIDAYS ====================
    //
    // Public + school-specific holidays. Same read/write split as periods.
    //
    // Doc shape:
    //   { name: string, startDate: 'YYYY-MM-DD', endDate: 'YYYY-MM-DD',
    //     kind: 'public'|'school'|'exam-week', createdBy, createdAt, updatedAt }

    function isValidHolidayShape(d) {
      return d.keys().hasAll(['name', 'startDate', 'endDate', 'kind'])
        && d.name is string && d.name.size() > 0
        && d.startDate is string && d.startDate.size() == 10
        && d.endDate is string && d.endDate.size() == 10
        && d.kind in ['public', 'school', 'exam-week'];
    }

    match /school_holidays/{holidayId} {
      allow read: if isAuthenticated();

      allow create: if isAdmin(request.auth.uid)
        && isValidHolidayShape(request.resource.data);

      allow update: if isAdmin(request.auth.uid)
        && isValidHolidayShape(request.resource.data);

      allow delete: if isAdmin(request.auth.uid);
    }

    // ==================== TIMETABLE — ENTRIES ====================
    //
    // One row per (slot, term, year, day, period). Keyed by slot, never by
    // teacher, so cover / TP / new-assignment changes auto-adjust without
    // any write here.
    //
    // One row = one subject in ONE period. Doubles / triples are worked
    // out by the app from consecutive periods (isDouble is always false on
    // new rows; old rows with true are split by the Timetable data check).
    //
    // Approval workflow (see timetable_submissions):
    //   Teacher submits   → rows 'pending' (+ a submission doc)
    //   Admin approves    → rows 'active'; the subject's previous live
    //                       rows → 'archived'
    //   Admin rejects     → rows 'rejected' (with rejectedReason)
    //
    // Doc shape:
    //   { slotId, classId, className, subject, normalizedSubject,
    //     term: 'Term 1'|'Term 2'|'Term 3', year: int,
    //     dayOfWeek: int 1..5, periodIndex: int >= 1, isDouble: bool,
    //     venue?: string,
    //     status: 'draft'|'pending'|'active'|'rejected'|'archived',
    //     submittedByUid, submittedAt, approvedByUid, approvedAt,
    //     rejectedReason, batchId?, createdAt, updatedAt }

    function isValidTerm(v) {
      return v == 'Term 1' || v == 'Term 2' || v == 'Term 3';
    }

    function isValidEntryStatus(v) {
      return v == 'draft' || v == 'pending' || v == 'active' || v == 'rejected'
        || v == 'archived';
    }

    function isValidEntryShape(d) {
      return d.keys().hasAll([
        'slotId', 'classId', 'className', 'subject', 'normalizedSubject',
        'term', 'year', 'dayOfWeek', 'periodIndex', 'isDouble', 'status'
      ])
      && d.slotId is string
      && d.classId is string
      && d.className is string
      && d.subject is string
      && d.normalizedSubject is string
      && isValidTerm(d.term)
      && d.year is int
      && d.dayOfWeek is int && d.dayOfWeek >= 1 && d.dayOfWeek <= 5
      && d.periodIndex is int && d.periodIndex >= 1
      && d.isDouble is bool
      && isValidEntryStatus(d.status);
    }

    match /timetable_entries/{entryId} {

      // Any authenticated user may read (teachers see their own lessons).
      allow read: if isAuthenticated();

      // The timetable is generated and published by the school (admin):
      // teachers receive it and can no longer write rows themselves.
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // ==================== TIMETABLE — SUBMISSIONS ====================
    //
    // One doc per teacher submission. Approving it replaces the whole live
    // timetable of the subjects in scopeSlotIds.
    //   Teacher: creates their own (pending); may shrink or supersede their
    //            own pending one when they resubmit; may delete it.
    //   Admin:   approves / rejects.

    function isValidSubmissionShape(d) {
      return d.keys().hasAll(['teacherId', 'term', 'year', 'scopeSlotIds', 'status'])
        && d.teacherId is string
        && isValidTerm(d.term)
        && d.year is int
        && d.scopeSlotIds is list
        && d.status in ['pending', 'approved', 'rejected', 'superseded'];
    }

    match /timetable_submissions/{submissionId} {
      allow read: if isAuthenticated();
      // Teachers no longer submit timetables (the school timetable is
      // generated and published). Kept readable for the record.
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // ==================== TIMETABLE GENERATOR ====================
    //
    // timetable_config/school       curriculum, rooms, events (admin or a
    //                               Timetabler)
    // timetable_versions/{id}       generated timetables. A Timetabler works
    //                               on drafts; only an admin publishes,
    //                               archives or deletes a published one.
    // timetable_signoffs/{id}       a department's allocations are complete
    //                               for a term: its HoD (own department) or
    //                               an admin.
    // staff_roles/{uid}__timetabler a HoD the admin allows to generate.

    function isTimetabler() {
      return isHod()
        && exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid + '__timetabler'))
        && get(/databases/$(database)/documents/staff_roles/$(request.auth.uid + '__timetabler')).data.get('status', '') == 'active';
    }

    match /timetable_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(request.auth.uid) || isTimetabler();
    }

    match /timetable_versions/{versionId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(request.auth.uid)
        || (isTimetabler()
            && request.resource.data.status == 'draft'
            && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin(request.auth.uid)
        || (isTimetabler()
            && resource.data.status == 'draft'
            && request.resource.data.status == 'draft');
      allow delete: if isAdmin(request.auth.uid)
        || (isTimetabler() && resource.data.status == 'draft');
    }

    match /timetable_signoffs/{signoffId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin(request.auth.uid)
        || (isHod()
            && request.resource.data.department == hodDept()
            && request.resource.data.byUid == request.auth.uid
            && request.resource.data.byRole == 'hod');
      allow delete: if isAdmin(request.auth.uid)
        || (isHod() && resource.data.department == hodDept());
    }

    // ==================== REPORT CARDS ====================
    match /reportCards/{reportCardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin(request.auth.uid) || isTeacher(request.auth.uid)
      );
    }

    match /report_cards/{reportCardId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin(request.auth.uid) || isTeacher(request.auth.uid)
      );
    }

    // ==================== ATTENDANCE TRENDS ====================
    match /attendanceTrends/{trendId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        isAdmin(request.auth.uid) || isTeacher(request.auth.uid)
      );
    }

    // ==================== EXAM CONFIGURATION ====================
    match /examConfigs/{configId} {
      // Public read: the Parent Portal must use the same active exams as
      // the admin's report card. Configs hold only dates and mark totals.
      allow read: if true;
      // Admin only: only the admin Exam Management page writes configs, and
      // a teacher changing them would change every class's results.
      allow write: if isAdmin(request.auth.uid);
    }

    // ==================== SMS ENGINE (LOCKED DOWN) ====================
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /recipients/{recipientId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /sms_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ==================== BACKSTOP CATCH-ALL ====================
    match /{collection}/{documentId} {
      allow read: if isAuthenticated() && !isPrivateCollection(collection);
      allow write: if !hasExplicitRules(collection)
        && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }

    match /{collection}/{documentId}/{nested=**} {
      allow read: if isAuthenticated() && !isPrivateCollection(collection);
      allow write: if !hasExplicitRules(collection)
        && (isAdmin(request.auth.uid) || isTeacher(request.auth.uid));
    }
  }
}